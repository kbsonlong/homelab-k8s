# Copy to .env. Never commit .env.
KUBE_CONTEXT=lab-default
BASE_DOMAIN=kbsonlong.com
LB_POOL_START=192.168.3.240
LB_POOL_STOP=192.168.3.249

# Required by make deploy. Use a password manager or CI secret.
GITEA_ADMIN_USER=along
GITEA_ADMIN_EMAIL=admin@example.invalid
GITEA_ADMIN_PASSWORD=
GITEA_DB_PASSWORD=

# Optional proxy for GitHub/Docker/OCI downloads.
HTTPS_PROXY=http://192.168.3.16:1087
HTTP_PROXY=http://192.168.3.16:1087

# ---- WAF（追加到 .env.example）----
WAF_GIT_TOKEN=            # Gitea token，需要 repo 读写权限
WAF_ARGOCD_TOKEN=         # Argo CD 项目 token（需要 get、sync 权限）
WAF_OAUTH_CLIENT_ID=      # Gitea OAuth2 应用，回调地址 https://waf.kbsonlong.com/oauth2/callback
WAF_OAUTH_CLIENT_SECRET=
WAF_ALERT_TOKEN=          # 可选：留空时自动生成
