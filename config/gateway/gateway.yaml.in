apiVersion: gateway.networking.k8s.io/v1
kind: GatewayClass
metadata:
  name: cilium
spec:
  controllerName: io.cilium/gateway-controller
  # HTTP access log -> CiliumGatewayClassConfig below; details in docs/gateway-access-log.md.
  # Field is co-managed: cilium chart owns the object (gatewayAPI.gatewayClass.create=auto),
  # helm 3-way merge keeps this kubectl-added field across upgrades.
  parametersRef:
    group: cilium.io
    kind: CiliumGatewayClassConfig
    name: gateway-access-log
    namespace: cilium-gateway
---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: lab-gateway
  namespace: cilium-gateway
spec:
  gatewayClassName: cilium
  listeners:
    - name: http
      protocol: HTTP
      port: 80
      allowedRoutes:
        namespaces:
          from: All
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: argocd-ui
  namespace: argocd
  labels:
    waf.kbsonlong.com/mirror: "true"
spec:
  parentRefs:
    - name: lab-gateway
      namespace: cilium-gateway
      sectionName: http
  hostnames:
    - argocd.${BASE_DOMAIN}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      # 旁路 WAF（docs/waf.md）：主链路直连后端，RequestMirror 异步复制给 waf/crs-detector
      # 回滚到串联 WAF：backendRefs 改回 crs-argocd.waf:80，并删除 RequestMirror
      filters:
        - type: RequestMirror
          requestMirror:
            backendRef:
              name: crs-detector
              namespace: waf
              port: 8080
      backendRefs:
        - name: argo-cd-argocd-server
          port: 80
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: gitea-http
  namespace: gitea
  labels:
    waf.kbsonlong.com/mirror: "true"
spec:
  parentRefs:
    - name: lab-gateway
      namespace: cilium-gateway
      sectionName: http
  hostnames:
    - gitea.${BASE_DOMAIN}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      # tunnel->gateway is plain HTTP; tell Gitea the public scheme is HTTPS
      filters:
        - type: RequestHeaderModifier
          requestHeaderModifier:
            set:
              - name: X-Forwarded-Proto
                value: https
        # 旁路 WAF（docs/waf.md）：RequestMirror 异步复制给 waf/crs-detector，主链路直连后端
        # 回滚到串联 WAF：backendRefs 改回 crs-gitea.waf:80，并删除 RequestMirror
        - type: RequestMirror
          requestMirror:
            backendRef:
              name: crs-detector
              namespace: waf
              port: 8080
      backendRefs:
        - name: gitea-http
          port: 3000
---
# HTTP access log: JSON -> cilium-envoy DaemonSet stdout (verified 2026-10-16, Cilium 1.20.2).
# Query/rollback: docs/gateway-access-log.md. NOTE: CRD is v2alpha1, re-check on Cilium upgrades.
apiVersion: cilium.io/v2alpha1
kind: CiliumGatewayClassConfig
metadata:
  name: gateway-access-log
  namespace: cilium-gateway
spec:
  telemetry:
    accessLogs:
      - format: JSON
        targets:
          - HTTP
        json:
          timestamp: "%START_TIME%"
          gateway: "%CILIUM_GATEWAY_NAME%"
          gateway_namespace: "%CILIUM_GATEWAY_NAMESPACE%"
          client_ip: "%DOWNSTREAM_REMOTE_ADDRESS_WITHOUT_PORT%"
          x_forwarded_for: "%REQ(X-FORWARDED-FOR)%"
          # Cloudflare 透传的真实客户端 IP；WAF 封禁按它匹配（只有经过 Tunnel 的请求才可信）
          cf_connecting_ip: "%REQ(CF-CONNECTING-IP)%"
          host: "%REQ(:AUTHORITY)%"
          method: "%REQ(:METHOD)%"
          protocol: "%PROTOCOL%"
          uri: "%REQ(:PATH)%"
          user_agent: "%REQ(USER-AGENT)%"
          request_id: "%REQ(X-REQUEST-ID)%"
          status: "%RESPONSE_CODE%"
          response_flags: "%RESPONSE_FLAGS%"
          bytes_received: "%BYTES_RECEIVED%"
          bytes_sent: "%BYTES_SENT%"
          duration_ms: "%DURATION%"
          upstream_service_time: "%RESP(X-ENVOY-UPSTREAM-SERVICE-TIME)%"
          upstream_host: "%UPSTREAM_HOST%"
          upstream_cluster: "%UPSTREAM_CLUSTER%"
